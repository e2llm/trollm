# Build from repository root. No Android SDK, inference backend or model files.
ARG NODE_IMAGE=docker.io/library/node:22.22.2-bookworm-slim@sha256:9f6d5975c7dca860947d3915877f85607946403fc55349f39b4bc3688448bb6e
ARG RUST_IMAGE=docker.io/library/rust:1.90.0-bookworm@sha256:3914072ca0c3b8aad871db9169a651ccfce30cf58303e5d6f2db16d1d8a7e58f
ARG CC_RUNTIME_IMAGE=gcr.io/distroless/cc-debian13:nonroot@sha256:cb87acc574abe719b6e5c547384defa2f7b1f24af9605d3f618cf852495d8be2
ARG RUNTIME_IMAGE=gcr.io/distroless/base-nossl-debian13:nonroot@sha256:89815d620ac01d8de13cdaf04d19ed874447ca2296d4985b14b818f6e5e47854
FROM ${NODE_IMAGE} AS web
WORKDIR /src/apps/flow-review/web
COPY apps/flow-review/web/package*.json ./
RUN npm ci --no-audit --no-fund --fetch-retries=2 --fetch-timeout=60000
COPY apps/flow-review/web/ ./
# Keep the receipt and built inventory in this same workdir. A cached prebuild
# audit alone cannot qualify newly built assets.
RUN npm run audit:prebuild && npm run build && npm run audit:final

FROM ${RUST_IMAGE} AS server
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY scripts/make_flow_review_notices.py scripts/
COPY scripts/android/make_apk_notices.py scripts/android/
COPY licenses/upstream/ licenses/upstream/
COPY crates/ crates/
COPY schemas/ schemas/
COPY flows/starters/browser-summary/setup.json flows/starters/browser-summary/setup.json
COPY apps/flow-review/server/ apps/flow-review/server/
COPY apps/desktop/server/ apps/desktop/server/
RUN if ! command -v python3 >/dev/null; then \
      export http_proxy="${http_proxy:-${HTTP_PROXY:-}}" https_proxy="${https_proxy:-${HTTPS_PROXY:-}}"; \
      apt-get update && apt-get install -y --no-install-recommends python3 \
        && rm -rf /var/lib/apt/lists/*; \
    fi
# Use the toolchain already installed in the pinned builder. Building does not
# need the optional lint components requested by the repository toolchain file.
RUN CARGO_BUILD_JOBS=2 rustup run 1.90.0 cargo build --locked --release \
    --target x86_64-unknown-linux-gnu -p trollm-flow-review --bin trollm-flow-review \
    --message-format=json-render-diagnostics > /cargo-build.jsonl \
    && python3 scripts/make_flow_review_notices.py collect --build-messages /cargo-build.jsonl \
        --sysroot "$(rustup run 1.90.0 rustc --print sysroot)" /out/notices \
    && readelf -d target/x86_64-unknown-linux-gnu/release/trollm-flow-review > /out-dependencies.txt \
    && ! grep NEEDED /out-dependencies.txt | grep -Ev '\[(libgcc_s\.so\.1|libm\.so\.6|libc\.so\.6|ld-linux-x86-64\.so\.2)\]' \
    && mkdir -p /out/packages

# The Rust TLS stack does not link OpenSSL/zlib. Retain only its required
# compiler runtime from the maintained cc image, including package/license data.
FROM ${CC_RUNTIME_IMAGE} AS compiler-runtime
FROM ${RUNTIME_IMAGE}
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/e2llm/trollm" \
    org.opencontainers.image.revision="${SOURCE_REVISION}" \
    org.opencontainers.image.description="Self-hosted trollm flow package review companion" \
    org.opencontainers.image.licenses="Apache-2.0"
COPY --from=compiler-runtime /usr/lib/x86_64-linux-gnu/libgcc_s.so.1 /usr/lib/x86_64-linux-gnu/libgcc_s.so.1
COPY --from=compiler-runtime /var/lib/dpkg/status.d/libgcc-s1* /var/lib/dpkg/status.d/
COPY --from=compiler-runtime /var/lib/dpkg/status.d/gcc-14-base* /var/lib/dpkg/status.d/
COPY --from=compiler-runtime /usr/share/doc/gcc-14-base/ /usr/share/doc/gcc-14-base/
COPY --from=compiler-runtime /usr/share/doc/libgcc-s1 /usr/share/doc/libgcc-s1
WORKDIR /app
COPY --from=server /out/packages/ /packages/
COPY --from=server /src/target/x86_64-unknown-linux-gnu/release/trollm-flow-review /app/trollm-flow-review
COPY LICENSE THIRD_PARTY_NOTICES.md /app/
COPY --from=server /out/notices/ /app/notices/
COPY --from=web /src/apps/flow-review/web/dist/ /app/web/
USER 10001:10001
ENV FLOW_REVIEW_BIND=0.0.0.0:8080 \
    FLOW_REVIEW_PACKAGES=/packages \
    FLOW_REVIEW_STATIC=/app/web \
    FLOW_REVIEW_TEMP=/tmp/trollm-flow-review
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/app/trollm-flow-review", "--healthcheck"]
ENTRYPOINT ["/app/trollm-flow-review"]
