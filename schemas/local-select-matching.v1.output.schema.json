{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "local.select_matching v1 result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceSha256",
    "index",
    "selected"
  ],
  "properties": {
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "selected": {
      "type": "object"
    }
  }
}
