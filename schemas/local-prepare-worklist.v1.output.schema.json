{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "context",
    "items"
  ],
  "properties": {
    "format": {
      "const": "trollm.local.prepare_worklist.v1"
    },
    "context": {
      "type": "string",
      "maxLength": 4096
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "value": {
            "type": "object"
          }
        }
      }
    }
  }
}
