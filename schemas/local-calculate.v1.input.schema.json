{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "local.calculate v1 arguments",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "left", "right"],
  "properties": {
    "operation": {"enum": ["add", "subtract", "multiply", "divide", "compare"]},
    "left": {"$ref": "#/$defs/decimal"},
    "right": {"$ref": "#/$defs/decimal"}
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^-?(0|[1-9][0-9]{0,11})([.][0-9]{1,6})?$",
      "not": {"pattern": "[\\r\\n]"}
    }
  }
}
