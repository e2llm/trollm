{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "count",
    "sum",
    "terms"
  ],
  "properties": {
    "format": {
      "const": "trollm.local.collection_total.v1"
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "sum": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^-?(0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?$"
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "amount"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "amount": {
            "type": "string",
            "maxLength": 20,
            "pattern": "^-?(0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?$"
          }
        }
      }
    }
  }
}
