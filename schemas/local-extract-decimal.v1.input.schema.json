{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "local.extract_decimal v1 arguments",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "primary",
    "secondary",
    "rules"
  ],
  "properties": {
    "primary": {
      "type": "string",
      "maxLength": 16384,
      "description": "At most 16384 UTF-8 bytes; gateway and standalone validation also enforce the byte bound."
    },
    "secondary": {
      "type": "string",
      "maxLength": 16384,
      "description": "At most 16384 UTF-8 bytes; gateway and standalone validation also enforce the byte bound."
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix",
        "fractionDigits"
      ],
      "properties": {
        "after": {
          "$ref": "#/$defs/marker"
        },
        "before": {
          "$ref": "#/$defs/marker"
        },
        "stopBefore": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/marker"
          }
        },
        "prefix": {
          "$ref": "#/$defs/marker"
        },
        "fractionDigits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "minimumExclusive": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^-?(0|[1-9][0-9]{0,11})([.][0-9]{1,6})?$"
        }
      }
    }
  },
  "$defs": {
    "marker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "At most 256 UTF-8 bytes; the runtime enforces the byte bound in addition to maxLength."
    }
  }
}
