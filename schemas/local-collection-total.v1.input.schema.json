{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expected",
    "results",
    "expectedId",
    "resultId",
    "outcome",
    "amount"
  ],
  "properties": {
    "expected": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8
    },
    "expectedId": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(?:/(?:[^~]|~[01])*)?$"
    },
    "resultId": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(?:/(?:[^~]|~[01])*)?$"
    },
    "outcome": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(?:/(?:[^~]|~[01])*)?$"
    },
    "amount": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(?:/(?:[^~]|~[01])*)?$"
    }
  }
}
