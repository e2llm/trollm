{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "local.order_records v1 arguments",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "schema",
    "field",
    "prefix",
    "fractionDigits",
    "groupSize"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object"
      },
      "description": "Original objects, at most 32 MiB serialized JSON; never truncated."
    },
    "schema": {
      "type": "object",
      "description": "Offline JSON Schema predicate, at most 16 KiB and depth 16."
    },
    "field": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(?:/(?:[^~]|~[01])*)?$"
    },
    "prefix": {
      "type": "string",
      "maxLength": 256
    },
    "fractionDigits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "groupSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    }
  }
}
