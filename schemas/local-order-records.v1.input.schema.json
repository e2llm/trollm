{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "local.order_records v1 arguments",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "schema",
    "field",
    "prefix",
    "fractionDigits",
    "groupSize"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object"
      },
      "description": "Original objects, at most 32 MiB serialized JSON; never truncated."
    },
    "schema": {
      "type": "object",
      "description": "Offline JSON Schema predicate, at most 16 KiB and depth 16."
    },
    "field": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(?:/(?:[^~]|~[01])*)?$"
    },
    "prefix": {
      "type": "string",
      "maxLength": 256
    },
    "fractionDigits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "groupSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "keyExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stopBefore",
        "repeated"
      ],
      "properties": {
        "stopBefore": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "repeated": {
          "const": "identical"
        }
      },
      "description": "Opt-in literal window before the earliest exact stop marker; repeated prefixed decimals must all be identical. Original records remain unchanged; one invalid admitted key fails the entire operation."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "keyExtraction"
        ]
      },
      "then": {
        "properties": {
          "prefix": {
            "minLength": 1
          }
        }
      }
    }
  ]
}
